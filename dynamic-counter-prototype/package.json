{
  "name": "dynamic-counter-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "playwright test",
    "test:release": "playwright test --config playwright.release.config.ts",
    "test:sites": "node --test tests/sites-worker.test.mjs tests/pwa-build.test.mjs",
    "test:rules": "node --experimental-strip-types --test tests/campaign-rules.test.ts",
    "test": "npm run test:rules && npm run build && npm run test:runtime && npm run test:release && npm run test:sites",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "preview": "vite preview",
    "prebuild": "npm run check:runtime",
    "build": "tsc && vite build && node scripts/prepare-pwa-build.mjs && node scripts/prepare-sites-build.mjs"
  },
  "dependencies": {
    "@fontsource/noto-serif-sc": "5.2.8",
    "@fontsource/roboto": "5.2.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
